# Neo vào gốc repo: không neo thì nuốt luôn repo giả lập của e2e
# (apps/mac/Tests/E2E/fixture-repo/memory/), và e2e hỏng trên bản clone mới.
/memory/
/goals/
/journal/

# Bản dựng để chia sẻ
dist/
*.zip

__pycache__/
.DS_Store
node_modules/

